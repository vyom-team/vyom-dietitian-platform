// Vyom — database schema
//
// Conventions (see docs/database.md for the full rationale):
//   - Models are PascalCase; tables are snake_case plural via @@map.
//   - Prisma fields are camelCase; columns are snake_case via @map.
//   - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
//   - Every entity carries createdAt / updatedAt, stored in UTC (timestamptz).
//   - Organization is the tenant. Every future tenant-owned table gets an
//     organizationId column and an index on it.
//
// This schema is deliberately small. It covers only what Phase 3
// (auth/RBAC/RLS) and Phase 4 (organization onboarding) need. Clients, plans,
// foods, logs, and nutrition data are added by the phases that own them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Lifecycle of a tenant. Organizations are archived, never hard-deleted —
/// their data is clinical and subject to retention obligations.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

/// Role a user holds within one organization.
///
/// Defined now so the schema is shaped correctly, but nothing enforces these
/// yet — authorization arrives in Phase 3. SUPER_ADMIN is the internal Vyom
/// platform role and is not granted through normal organization onboarding.
enum OrganizationRole {
  SUPER_ADMIN
  OWNER
  DIETITIAN
  RECEPTIONIST
  CLIENT

  @@map("organization_role")
}

/// Whether a membership is usable. INVITED covers a member who has been sent an
/// invitation but has not yet completed sign-up.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("membership_status")
}

/// Commercial tier. Limits and pricing are configuration, not schema — they are
/// never hard-coded against these values.
enum SubscriptionPlan {
  FREE
  PRO
  CLINIC
  ENTERPRISE

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A tenant: one dietetics practice or clinic.
///
/// Owns every piece of tenant data in the system. Isolation between
/// organizations is the platform's most important security property.
model Organization {
  id      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String             @db.VarChar(120)
  /// URL-safe identifier, e.g. "healthy-life-nutrition". Unique platform-wide.
  slug    String             @unique @db.VarChar(80)
  logoUrl String?            @map("logo_url") @db.Text
  status  OrganizationStatus @default(ACTIVE)

  /// Set when the organization is archived. Presence of this value — not row
  /// deletion — is what takes a tenant out of service.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members      OrganizationMember[]
  subscription Subscription?

  /// Dashboards list active organizations by recency; slug already has a unique
  /// index and needs no second one.
  @@index([status, createdAt])
  @@map("organizations")
}

/// A person. Deliberately holds no credentials.
///
/// Authentication is Supabase Auth's responsibility (Phase 3). `authUserId`
/// will hold the `auth.users.id` UUID issued by Supabase; it is nullable
/// because a profile can be created by invitation before the person signs up.
/// This database never stores passwords, hashes, OTPs, or session tokens.
model UserProfile {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// FK to Supabase `auth.users.id`. Not a Prisma relation: that table lives in
  /// a schema Prisma does not manage. Phase 3 wires up the linkage.
  authUserId String? @unique @map("auth_user_id") @db.Uuid

  fullName  String? @map("full_name") @db.VarChar(120)
  /// Stored lowercase. Unique platform-wide so one person maps to one profile.
  email     String  @unique @db.VarChar(255)
  phone     String? @db.VarChar(20)
  avatarUrl String? @map("avatar_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMember[]

  @@map("user_profiles")
}

/// Join between a person and an organization, carrying their role.
///
/// Membership is modelled as its own table rather than an `organizationId` on
/// UserProfile so a person can belong to several organizations — a consulting
/// dietitian working with two clinics, for example — without reworking the
/// schema later.
model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(INVITED)

  invitedAt DateTime  @default(now()) @map("invited_at") @db.Timestamptz(6)
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         UserProfile  @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// One membership per person per organization. Changing someone's role
  /// updates this row rather than adding another.
  @@unique([organizationId, userId])
  /// "Who belongs to this organization", filtered by role — the query behind
  /// team lists and permission checks.
  @@index([organizationId, role])
  /// "Which organizations does this person belong to" — runs on every sign-in
  /// once authentication exists.
  @@index([userId])
  /// Supports the RLS helper functions, which resolve the caller's active
  /// memberships on every policy evaluation. See the Phase 3 migration.
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_members")
}

/// Commercial subscription for an organization.
///
/// Attached to the organization, never to a user, so ownership survives a
/// change of practitioner. Payment-provider identifiers are added by the
/// billing phase; no payment behaviour exists yet.
model Subscription {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique: an organization has exactly one subscription record, whose plan
  /// and status change over time.
  organizationId String             @unique @map("organization_id") @db.Uuid
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(TRIALING)

  trialStartsAt DateTime? @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt   DateTime? @map("trial_ends_at") @db.Timestamptz(6)

  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)

  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Platform-wide sweeps: expiring trials, past-due accounts.
  @@index([status, trialEndsAt])
  @@map("subscriptions")
}
