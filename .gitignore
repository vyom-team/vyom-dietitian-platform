# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values
.env
.env.*
# ...but the documented template must be committed
!.env.example

# local editor settings
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client — generated from schema.prisma by `npm run db:generate`
# (also runs on postinstall, so a fresh clone gets it automatically)
/src/generated/prisma

# Agent skill docs vendored by `prisma init`. Not committed: .agents/skills is
# ~465KB of third-party documentation, and the .claude/.windsurf copies are
# absolute-path symlinks into it that would break on any other machine.
# Recreate locally with `npx prisma init` if you want them.
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
