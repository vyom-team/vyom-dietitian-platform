// Vyom — database schema
//
// Conventions (see docs/database.md for the full rationale):
//   - Models are PascalCase; tables are snake_case plural via @@map.
//   - Prisma fields are camelCase; columns are snake_case via @map.
//   - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
//   - Every entity carries createdAt / updatedAt, stored in UTC (timestamptz).
//   - Organization is the tenant. Every future tenant-owned table gets an
//     organizationId column and an index on it.
//
// This schema is deliberately small. It covers only what Phase 3
// (auth/RBAC/RLS) and Phase 4 (organization onboarding) need. Clients, plans,
// foods, logs, and nutrition data are added by the phases that own them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Lifecycle of a tenant. Organizations are archived, never hard-deleted —
/// their data is clinical and subject to retention obligations.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

/// Role a user holds within one organization.
///
/// Defined now so the schema is shaped correctly, but nothing enforces these
/// yet — authorization arrives in Phase 3. SUPER_ADMIN is the internal Vyom
/// platform role and is not granted through normal organization onboarding.
enum OrganizationRole {
  SUPER_ADMIN
  OWNER
  DIETITIAN
  RECEPTIONIST
  CLIENT

  @@map("organization_role")
}

/// Whether a membership is usable. INVITED covers a member who has been sent an
/// invitation but has not yet completed sign-up.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("membership_status")
}

/// Commercial tier. Limits and pricing are configuration, not schema — they are
/// never hard-coded against these values.
enum SubscriptionPlan {
  FREE
  PRO
  CLINIC
  ENTERPRISE

  @@map("subscription_plan")
}

/// Lifecycle of a team invitation.
///
/// EXPIRED is derived from `expiresAt` at read time rather than written by a
/// background job — a row can be past its expiry while still marked PENDING, so
/// every check must compare the timestamp, not trust the status alone.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

/// Lifecycle of a client record.
///
/// Archive, never delete: future assessments, plans, and progress records will
/// reference clients, and clinical records carry retention obligations.
enum ClientStatus {
  ACTIVE
  ARCHIVED

  @@map("client_status")
}

/// Recorded because dietary reference values differ by sex, and because
/// practitioners address clients correctly.
///
/// Deliberately short. It is *not* used for any decision in this phase — no
/// calculation exists yet — and the nutrition phase will define precisely how
/// it is used against a published reference.
enum ClientGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED

  @@map("client_gender")
}

/// Why an assessment was taken.
///
/// Two values only. A larger speculative enum would invite dead options; more
/// can be added when a real workflow needs them.
enum AssessmentType {
  INITIAL
  FOLLOW_UP

  @@map("assessment_type")
}

/// Whether an assessment is still being filled in.
///
/// Two states, deliberately. Approval and review workflows are not part of how
/// a dietitian works today, and inventing them would add ceremony nobody asked
/// for.
enum AssessmentStatus {
  DRAFT
  COMPLETED

  @@map("assessment_status")
}

/// Habitual physical activity, as judged by the practitioner.
///
/// Recorded only. It is **not** multiplied by anything: activity factors for
/// energy requirements come from the PRD and are unknown to this codebase, so
/// no calculation may use this value until that phase supplies them.
enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE

  @@map("activity_level")
}

/// Dietary pattern. `EGGETARIAN` is included because it is a distinct and
/// common category in Indian practice, not a variant of vegetarian.
enum DietType {
  VEGETARIAN
  EGGETARIAN
  NON_VEGETARIAN
  VEGAN
  OTHER

  @@map("diet_type")
}

/// What the client wants to achieve, in their practitioner's words.
///
/// Recorded, never prescribed. Nothing derives a calorie deficit, a protein
/// target, or a meal frequency from this — those require reference values this
/// phase does not have.
enum PrimaryGoal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  WEIGHT_MAINTENANCE
  MUSCLE_GAIN
  GENERAL_WELLNESS
  CONDITION_MANAGEMENT
  OTHER

  @@map("primary_goal")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A tenant: one dietetics practice or clinic.
///
/// Owns every piece of tenant data in the system. Isolation between
/// organizations is the platform's most important security property.
model Organization {
  id      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String             @db.VarChar(120)
  /// URL-safe identifier, e.g. "healthy-life-nutrition". Unique platform-wide.
  /// Always derived server-side from the name; never accepted from a client.
  slug    String             @unique @db.VarChar(80)
  logoUrl String?            @map("logo_url") @db.Text
  status  OrganizationStatus @default(ACTIVE)

  // --- Practice details, captured during onboarding -------------------------
  // "Practice" is the user-facing word for an Organization. The database keeps
  // the tenant-neutral name; only the UI says practice.

  /// ISO 3166-1 alpha-2, e.g. "IN". A code rather than a display name so it
  /// stays stable across locales and translations.
  country String @default("IN") @db.VarChar(2)

  /// IANA timezone identifier, e.g. "Asia/Kolkata". Never an abbreviation like
  /// "IST": those are ambiguous and do not carry daylight-saving rules, which
  /// scheduling and reminders will depend on.
  timezone String @default("Asia/Kolkata") @db.VarChar(64)

  /// Practice contact address — distinct from the owner's login email.
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(32)
  /// http/https only; enforced by validation before it reaches the database.
  website String? @db.Text

  addressLine String? @map("address_line") @db.VarChar(200)
  city        String? @db.VarChar(100)
  state       String? @db.VarChar(100)
  postalCode  String? @map("postal_code") @db.VarChar(20)

  /// Next client number to issue for this practice.
  ///
  /// A counter on the tenant row rather than `count(clients) + 1`: the count
  /// approach races under concurrent creation and reuses numbers after an
  /// archive. Incrementing this column takes a row lock, so two simultaneous
  /// creations serialise and receive different numbers.
  nextClientNumber Int @default(1) @map("next_client_number")

  /// Set when the organization is archived. Presence of this value — not row
  /// deletion — is what takes a tenant out of service.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members      OrganizationMember[]
  subscription Subscription?
  invitations  OrganizationInvitation[]
  clients      Client[]
  assessments  NutritionAssessment[]

  /// Dashboards list active organizations by recency; slug already has a unique
  /// index and needs no second one.
  @@index([status, createdAt])
  @@map("organizations")
}

/// A person. Deliberately holds no credentials.
///
/// Authentication is Supabase Auth's responsibility (Phase 3). `authUserId`
/// will hold the `auth.users.id` UUID issued by Supabase; it is nullable
/// because a profile can be created by invitation before the person signs up.
/// This database never stores passwords, hashes, OTPs, or session tokens.
model UserProfile {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// FK to Supabase `auth.users.id`. Not a Prisma relation: that table lives in
  /// a schema Prisma does not manage. Phase 3 wires up the linkage.
  authUserId String? @unique @map("auth_user_id") @db.Uuid

  fullName  String? @map("full_name") @db.VarChar(120)
  /// Stored lowercase. Unique platform-wide so one person maps to one profile.
  email     String  @unique @db.VarChar(255)
  phone     String? @db.VarChar(32)
  avatarUrl String? @map("avatar_url") @db.Text

  /// Professional credential shown on plans and documents, e.g. "Registered
  /// Dietitian". Free text: credentials vary by country and registering body,
  /// and an enum would exclude legitimate ones.
  professionalTitle String? @map("professional_title") @db.VarChar(120)
  bio               String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         OrganizationMember[]
  invitationsSent     OrganizationInvitation[] @relation("InvitationsSent")
  invitationsAccepted OrganizationInvitation[] @relation("InvitationsAccepted")
  clientsCreated      Client[]                 @relation("ClientsCreated")

  @@map("user_profiles")
}

/// Join between a person and an organization, carrying their role.
///
/// Membership is modelled as its own table rather than an `organizationId` on
/// UserProfile so a person can belong to several organizations — a consulting
/// dietitian working with two clinics, for example — without reworking the
/// schema later.
model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(INVITED)

  invitedAt DateTime  @default(now()) @map("invited_at") @db.Timestamptz(6)
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                UserProfile           @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientAssignments   ClientAssignment[]
  assessmentsAuthored NutritionAssessment[]

  /// One membership per person per organization. Changing someone's role
  /// updates this row rather than adding another.
  @@unique([organizationId, userId])
  /// "Who belongs to this organization", filtered by role — the query behind
  /// team lists and permission checks.
  @@index([organizationId, role])
  /// "Which organizations does this person belong to" — runs on every sign-in
  /// once authentication exists.
  @@index([userId])
  /// Supports the RLS helper functions, which resolve the caller's active
  /// memberships on every policy evaluation. See the Phase 3 migration.
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_members")
}

/// An invitation for someone to join a practice as staff.
///
/// TOKEN HANDLING — the security-critical part of this model:
///
/// `tokenHash` stores a SHA-256 digest, never the token itself. The raw token
/// exists only in the invitation link. A leaked database backup therefore
/// yields no usable invitations, and lookup is by hash so the plaintext is
/// never compared, logged, or stored.
model OrganizationInvitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// Normalised to lowercase so one address cannot hold two invitations.
  email          String           @db.VarChar(255)
  /// Restricted to staff roles by application validation. OWNER, SUPER_ADMIN,
  /// and CLIENT are never assignable through an invitation.
  role           OrganizationRole
  /// SHA-256 of the raw token, hex encoded. Unique so a token identifies at
  /// most one invitation.
  tokenHash      String           @unique @map("token_hash") @db.VarChar(64)
  status         InvitationStatus @default(PENDING)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Who sent it. Restrict rather than cascade: an invitation is a record of
  /// something a person did, and it should survive their profile changing.
  invitedById String @map("invited_by_id") @db.Uuid

  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Optional note from the sender, shown in the email and on the accept page.
  message String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    UserProfile  @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   UserProfile? @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  /// One invitation row per address per practice. Re-inviting updates this row
  /// with a fresh token and expiry rather than accumulating duplicates, which
  /// is what stops an unbounded pile of pending invitations for one address.
  @@unique([organizationId, email])
  /// Drives the pending-invitations list on the team page.
  @@index([organizationId, status])
  /// Finds a person's invitations after they sign up under that address.
  @@index([email, status])
  @@map("organization_invitations")
}

/// A person the practice looks after.
///
/// A Client is a **domain record, not an identity**. Creating one does not
/// create a Supabase Auth user, and this model holds no credentials. A future
/// client portal will link a Client to an auth user through its own model
/// rather than by adding auth fields here.
///
/// The model is deliberately confined to identity, contact, and administrative
/// details. Weight, height, conditions, allergies, and every other clinical
/// value belong to the assessment and nutrition models that later phases
/// introduce — putting them here "for later" would produce a table nobody can
/// reason about and a permissions boundary nobody can enforce.
model Client {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Human-readable identifier, e.g. "VYM-000001". Generated server-side from a
  /// per-organization counter; never accepted from a client. Unique within the
  /// organization, not globally — practices should not be able to infer each
  /// other's client volume from a shared sequence.
  clientNumber String @map("client_number") @db.VarChar(20)

  firstName String @map("first_name") @db.VarChar(80)
  lastName  String @map("last_name") @db.VarChar(80)

  email String? @db.VarChar(255)
  phone String? @db.VarChar(32)

  /// Date only. Age is derived when needed and never stored — it would be wrong
  /// the day after it was written.
  dateOfBirth DateTime?     @map("date_of_birth") @db.Date
  gender      ClientGender?

  addressLine String? @map("address_line") @db.VarChar(200)
  city        String? @db.VarChar(100)
  state       String? @db.VarChar(100)
  postalCode  String? @map("postal_code") @db.VarChar(20)
  country     String? @db.VarChar(2)

  status     ClientStatus @default(ACTIVE)
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)

  /// Who created the record. Restrict rather than cascade: removing a staff
  /// member must never take client records with them.
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    UserProfile?          @relation("ClientsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  assignments  ClientAssignment[]
  assessments  NutritionAssessment[]

  /// Client numbers are unique per practice, and this also serves the
  /// "open client VYM-000124" lookup.
  @@unique([organizationId, clientNumber])
  /// The list query: this organization's clients, filtered by status.
  @@index([organizationId, status])
  /// Default ordering is newest first within a practice.
  @@index([organizationId, createdAt])
  /// Name search. A trigram index would serve `contains` better and can be
  /// added when volume justifies the write cost.
  @@index([organizationId, lastName, firstName])
  @@map("clients")
}

/// Links a client to the staff member responsible for them.
///
/// A join table rather than a `dietitianId` column on Client. The column would
/// work today and would have to be unpicked the moment a practice wants two
/// people on one client, or wants to know who handled someone last year. The
/// join table costs one row now and forecloses nothing.
///
/// Phase 6 keeps a single active assignment per client, enforced by a partial
/// unique index. Multiple concurrent assignments are a product decision, not a
/// schema change.
model ClientAssignment {
  id                   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String @map("client_id") @db.Uuid
  /// The membership, not the user: assignment is a role within one practice,
  /// and referencing the membership makes a cross-organization assignment
  /// impossible to express.
  organizationMemberId String @map("organization_member_id") @db.Uuid

  /// Null while active. Reassignment ends the current row and opens a new one,
  /// which preserves who handled a client and when.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Restrict)

  /// "Which clients am I responsible for" — the dietitian's list query.
  @@index([organizationMemberId, endedAt])
  @@index([clientId, endedAt])
  @@map("client_assignments")
}

/// A nutrition assessment taken for a client at a point in time.
///
/// A client accumulates assessments; each is a **separate, immutable-in-spirit
/// record of one consultation**. A follow-up creates a new row rather than
/// overwriting the previous one, because the value of this data is the trend
/// across visits, and an overwrite destroys exactly that.
///
/// SENSITIVITY: this table holds health information — conditions, medications,
/// allergies, and clinical notes. Access is restricted to clinical roles
/// (OWNER, DIETITIAN); a RECEPTIONIST who may manage the client record has no
/// business reading it. Nothing in the service logs these fields.
///
/// SCOPE: no calorie, protein, macro, or micronutrient value appears here. This
/// phase records what the practitioner observed. Deriving requirements needs
/// reference values from the PRD that this codebase does not have, and
/// inventing them would violate the project's prime directive.
model NutritionAssessment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised from the client so every policy and query can scope on it
  /// directly, without a join. Kept consistent by a database trigger.
  organizationId String @map("organization_id") @db.Uuid
  clientId       String @map("client_id") @db.Uuid

  /// The membership that recorded it, not the user: attribution belongs to a
  /// role within one practice, and the same person may work at several.
  createdByMemberId String @map("created_by_member_id") @db.Uuid

  assessmentType AssessmentType   @map("assessment_type")
  status         AssessmentStatus @default(DRAFT)

  /// The business date of the consultation — a calendar day, stored as DATE.
  /// Distinct from `createdAt`, which is when the row was written.
  assessmentDate DateTime @map("assessment_date") @db.Date

  // --- Measurements ---------------------------------------------------------
  // Canonical SI units, always. Never "5'8\"" or "70 kg" as text: a formatted
  // string cannot be compared across visits or converted for display.
  //
  // Decimal, not Float. Binary floating point cannot represent 70.1 exactly,
  // and a measurement that changes when it round-trips is unacceptable in a
  // clinical record.
  heightCm Decimal? @map("height_cm") @db.Decimal(5, 1)
  weightKg Decimal? @map("weight_kg") @db.Decimal(5, 1)

  // BMI is deliberately NOT stored. It is a pure function of height and weight,
  // and a stored copy can drift out of step with them the moment either is
  // corrected. It is derived on read — see src/lib/assessments/bmi.ts.

  // --- Health background ----------------------------------------------------
  // Free text, entered by the practitioner. A coded terminology system (SNOMED,
  // ICD) is a serious undertaking and would be premature; these fields record
  // what the clinician wrote, which is what a nutrition assessment actually is.
  medicalHistory        String? @map("medical_history") @db.Text
  healthConditions      String? @map("health_conditions") @db.Text
  currentMedications    String? @map("current_medications") @db.Text
  /// Kept separate from food preferences on purpose: an allergy is a safety
  /// constraint, a dislike is a preference. Merging them would let a future
  /// meal planner treat "doesn't like mushrooms" as clinically equivalent to
  /// "peanut allergy".
  allergiesIntolerances String? @map("allergies_intolerances") @db.Text

  // --- Lifestyle ------------------------------------------------------------
  activityLevel     ActivityLevel? @map("activity_level")
  exerciseFrequency String?        @map("exercise_frequency") @db.VarChar(200)
  occupation        String?        @db.VarChar(200)
  sleepPattern      String?        @map("sleep_pattern") @db.VarChar(200)
  /// Litres per day. Numeric so it can be trended; nothing acts on it yet.
  waterLitresPerDay Decimal?       @map("water_litres_per_day") @db.Decimal(3, 1)

  // --- Diet -----------------------------------------------------------------
  dietType      DietType? @map("diet_type")
  /// Only meaningful when dietType is OTHER.
  dietTypeOther String?   @map("diet_type_other") @db.VarChar(120)

  foodPreferences     String? @map("food_preferences") @db.Text
  foodsDisliked       String? @map("foods_disliked") @db.Text
  foodsAvoided        String? @map("foods_avoided") @db.Text
  dietaryRestrictions String? @map("dietary_restrictions") @db.Text

  // --- Goals ----------------------------------------------------------------
  primaryGoal      PrimaryGoal? @map("primary_goal")
  primaryGoalOther String?      @map("primary_goal_other") @db.VarChar(120)
  goalNotes        String?      @map("goal_notes") @db.Text

  // --- Notes ----------------------------------------------------------------
  assessmentNotes String? @map("assessment_notes") @db.Text

  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Restrict on both: an assessment is a clinical record and must survive the
  /// removal of anything that references it. Archiving a client leaves their
  /// assessment history untouched.
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByMember OrganizationMember @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)

  /// The history query: one client's assessments, newest first.
  @@index([clientId, assessmentDate(sort: Desc)])
  /// Practice-wide scoping, and the drafts-outstanding view.
  @@index([organizationId, status])
  @@index([organizationId, assessmentDate])
  @@index([createdByMemberId])
  @@map("nutrition_assessments")
}

/// Commercial subscription for an organization.
///
/// Attached to the organization, never to a user, so ownership survives a
/// change of practitioner. Payment-provider identifiers are added by the
/// billing phase; no payment behaviour exists yet.
model Subscription {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique: an organization has exactly one subscription record, whose plan
  /// and status change over time.
  organizationId String             @unique @map("organization_id") @db.Uuid
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(TRIALING)

  trialStartsAt DateTime? @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt   DateTime? @map("trial_ends_at") @db.Timestamptz(6)

  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)

  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Platform-wide sweeps: expiring trials, past-due accounts.
  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Phase 8A — nutrition reference data
//
// GLOBAL, NOT TENANT-OWNED. Everything below deliberately has no
// `organizationId`. IFCT's value for toor dal is the same fact for every
// practice, and copying it per tenant would multiply one dataset by the
// customer count and make a correction impossible to apply.
//
// This is the first data in the product that crosses tenants, so the security
// posture is inverted from every model above: readable by any clinical user of
// any practice, writable by nobody through the browser. See the migration.
//
// Organization-scoped custom foods and recipes are a later phase. They get
// their own models with an organizationId, not a nullable column here.
// ---------------------------------------------------------------------------

/// Whether a dataset may be used commercially or redistributed.
///
/// `UNKNOWN` is the default and means exactly that — nobody has checked. It is
/// never to be read as permission. Some Indian nutrition datasets carry
/// restrictions that have not been reviewed for this project.
enum DataUseStatus {
  UNKNOWN
  PERMITTED
  RESTRICTED
  PROHIBITED

  @@map("data_use_status")
}

/// How far a source has got through licence review.
///
/// Defaults to DEVELOPMENT_ONLY. Nothing in this codebase may set APPROVED —
/// that is a human legal decision recorded deliberately, not an import default.
enum SourcePermissionStatus {
  DEVELOPMENT_ONLY
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("source_permission_status")
}

/// Whether a source is in use. Superseded sources stay readable: food records
/// already reference them, and provenance must survive.
enum NutritionSourceStatus {
  ACTIVE
  SUPERSEDED
  DISABLED

  @@map("nutrition_source_status")
}

/// What kind of nutrient this is. Drives grouping in a future UI; carries no
/// calculation meaning.
enum NutrientCategory {
  ENERGY
  MACRONUTRIENT
  MINERAL
  VITAMIN
  OTHER

  @@map("nutrient_category")
}

/// Units a nutrient value can be expressed in.
///
/// Deliberately separate from the `Unit` table, which describes portions
/// (grams, cups, katori). "Katori" is never a nutrient unit, and one shared
/// vocabulary would permit it.
enum NutrientUnit {
  KCAL
  KJ
  G
  MG
  UG
  IU

  @@map("nutrient_unit")
}

/// Controlled food category. Extensible: adding a value is a migration, which
/// is the point — categories should not drift silently per import.
enum FoodCategory {
  GRAINS
  PULSES
  LEGUMES
  VEGETABLES
  FRUITS
  DAIRY
  NUTS
  SEEDS
  OILS
  SPICES
  BEVERAGES
  MEAT
  SEAFOOD
  EGGS
  PREPARED_FOODS
  OTHER

  @@map("food_category")
}

/// The form a food is in — orthogonal to its category. Rice is GRAINS whether
/// RAW or COOKED, and the nutrition differs sharply between the two.
///
/// There is deliberately no RECIPE value. A recipe is a different entity with
/// ingredients and a yield, and it arrives in a later phase with its own model.
/// A RECIPE value here would invite recipes into the foods table.
enum FoodType {
  RAW
  COOKED
  PROCESSED
  PACKAGED
  PREPARED
  INGREDIENT

  @@map("food_type")
}

/// Whether an external dataset record has been tied to a canonical food.
///
/// REVIEW_REQUIRED is the safe landing place for ambiguity. "Milk", "Milk,
/// whole", and "Milk, toned" must never be merged automatically on name
/// similarity — they are different foods with different nutrition.
enum SourceFoodMappingStatus {
  UNMAPPED
  MAPPED
  REVIEW_REQUIRED
  REJECTED

  @@map("source_food_mapping_status")
}

/// What a unit measures. HOUSEHOLD units (cup, katori, glass) have no universal
/// conversion to grams — that depends on the food's density, which is why
/// UnitConversion can be food-specific.
enum UnitCategory {
  WEIGHT
  VOLUME
  COUNT
  HOUSEHOLD

  @@map("unit_category")
}

/// Outcome of one ingestion run.
///
/// PARTIAL is a first-class result, not a failure: a dataset with a handful of
/// malformed rows should import the good ones and report the rest, rather than
/// discarding thousands of valid records.
enum DatasetImportStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED

  @@map("dataset_import_status")
}

/// A publisher of nutrition reference data — ICMR-NIN, USDA, and so on.
///
/// Holds identity and **licence terms**, which belong to the publisher rather
/// than to any one release. A specific release is a NutritionSourceVersion.
///
/// LICENCE POSTURE: every status field defaults to "not established". This
/// project is in development; no dataset here has been cleared for commercial
/// use, and the schema is built so that saying otherwise takes a deliberate
/// human write. See docs/nutrition-data.md.
model NutritionSource {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stable machine identifier, e.g. "IFCT", "INDB", "USDA_FDC". Referenced by
  /// import configuration, so it must not change once data exists.
  code String @unique @db.VarChar(40)
  name String @db.VarChar(200)

  /// Publishing body, e.g. "ICMR-National Institute of Nutrition".
  organization String? @db.VarChar(200)
  /// ISO 3166-1 alpha-2 of the population the data describes, e.g. "IN".
  /// India-first: this is what keeps foreign reference values from being
  /// applied to Indian clients by accident.
  country      String? @db.VarChar(2)
  region       String? @db.VarChar(100)

  description String? @db.Text
  sourceUrl   String? @map("source_url") @db.Text

  licenseName String? @map("license_name") @db.VarChar(200)
  licenseUrl  String? @map("license_url") @db.Text

  /// All three default to "not established". Never inferred from a licence
  /// name, a URL, or the absence of a notice.
  commercialUseStatus  DataUseStatus          @default(UNKNOWN) @map("commercial_use_status")
  redistributionStatus DataUseStatus          @default(UNKNOWN) @map("redistribution_status")
  permissionStatus     SourcePermissionStatus @default(DEVELOPMENT_ONLY) @map("permission_status")

  /// Whether attribution must be displayed wherever values from this source
  /// appear. Defaults to true: attributing unnecessarily is harmless, failing
  /// to attribute is not.
  attributionRequired Boolean @default(true) @map("attribution_required")
  /// The exact wording to display, when the licence specifies one.
  attributionText     String? @map("attribution_text") @db.Text

  status NutritionSourceStatus @default(ACTIVE)

  /// Free-form provenance that does not deserve a column — contact details,
  /// review notes, correspondence references.
  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions NutritionSourceVersion[]

  @@index([status])
  @@map("nutrition_sources")
}

/// One published release of a source — IFCT 2017, a future IFCT revision, an
/// INDB release.
///
/// Separate from NutritionSource because a new release must not corrupt
/// existing records. Values reference the *version*, so importing a later IFCT
/// leaves every IFCT 2017 value intact and still attributable. A single table
/// would have forced either an overwrite or a duplicated licence per release.
model NutritionSourceVersion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId String @map("source_id") @db.Uuid

  /// The publisher's own version label, e.g. "2017". Not parsed or compared as
  /// a number — version schemes differ between publishers.
  version String @db.VarChar(40)

  /// When the publisher released it, where known. Distinct from importedAt.
  releasedOn DateTime? @map("released_on") @db.Date
  /// When Vyom last ingested it. Null until an import completes.
  importedAt DateTime? @map("imported_at") @db.Timestamptz(6)

  notes    String? @db.Text
  metadata Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source          NutritionSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  foodNutrients   FoodNutrient[]
  sourceFoods     SourceFood[]
  imports         DatasetImport[]
  foodsOriginated Food[]          @relation("FoodOriginVersion")

  /// One row per release of a source. This pair is also the natural key the
  /// importer resolves from configuration.
  @@unique([sourceId, version])
  @@index([sourceId])
  @@map("nutrition_source_versions")
}

/// The nutrient dictionary — the vocabulary every measured value refers to.
///
/// A dictionary rather than columns on Food. A wide table would need a
/// migration per nutrient, could not record which source supplied which value,
/// and would make "the source did not measure this" indistinguishable from
/// "this is zero".
model Nutrient {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stable internal identifier, e.g. "ENERGY", "PROTEIN", "VITAMIN_C". Import
  /// mappings are written against this, so it must never be renamed in place.
  code String @unique @db.VarChar(60)
  name String @db.VarChar(120)

  category NutrientCategory
  /// The unit values of this nutrient are stored in. A value arriving in a
  /// different unit is a validation failure, never a silent conversion.
  unit     NutrientUnit

  description String? @db.Text

  /// Ordering for a future UI. Display concern only.
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  foodNutrients FoodNutrient[]

  @@index([category, displayOrder])
  @@map("nutrients")
}

/// A canonical Vyom food.
///
/// This is the entity the rest of the product talks to. It is *not* an IFCT row
/// or an INDB row — those are SourceFood records that map onto this. That
/// indirection is the whole point: a dietitian picks "Toor Dal", and which
/// dataset supplied its protein figure is provenance, not identity.
///
/// Carries no nutrient columns. Values live in FoodNutrient, one row per
/// nutrient per source version.
model Food {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The name a practitioner sees. Regional and alternate names are aliases.
  canonicalName String  @map("canonical_name") @db.VarChar(200)
  description   String? @db.Text

  category FoodCategory
  foodType FoodType     @map("food_type")

  /// Which dataset release this canonical record was first derived from.
  /// Provenance, not authority — a food may later carry values from several
  /// sources, and one created by hand has no origin version at all.
  originSourceVersionId String? @map("origin_source_version_id") @db.Uuid
  /// The publisher's own identifier in that release, e.g. an IFCT food code.
  /// Kept verbatim so a value can always be traced back to its printed row.
  originSourceFoodId    String? @map("origin_source_food_id") @db.VarChar(80)

  /// Deactivated rather than deleted: plans and logs will reference foods, and
  /// a withdrawn food must not break a historical record.
  isActive Boolean @default(true) @map("is_active")

  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  originSourceVersion NutritionSourceVersion? @relation("FoodOriginVersion", fields: [originSourceVersionId], references: [id], onDelete: Restrict)
  nutrients           FoodNutrient[]
  aliases             FoodAlias[]
  sourceFoods         SourceFood[]
  unitConversions     UnitConversion[]

  /// Idempotency key for imports. Re-running an import finds the food it
  /// created last time instead of inserting a second copy.
  @@unique([originSourceVersionId, originSourceFoodId], map: "foods_origin_unique")
  @@index([category, isActive])
  @@index([canonicalName])
  @@map("foods")
}

/// An alternate name for a food — "Tur Dal", "Arhar Dal", "Pigeon Pea".
///
/// The foundation for search, not a translation system. `languageCode` is
/// recorded where known so a later phase can build on it without a migration,
/// but nothing localises anything yet.
model FoodAlias {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foodId String @map("food_id") @db.Uuid

  alias String @db.VarChar(200)
  /// ISO 639-1 where known, e.g. "hi", "ta". Null for an unlabelled variant.
  languageCode String? @map("language_code") @db.VarChar(8)
  /// Where in India this name is used. Free text: regional naming does not fit
  /// a fixed list, and guessing one would exclude real names.
  region       String? @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  /// The same alias twice on one food is noise, and re-running an import must
  /// not accumulate copies.
  @@unique([foodId, alias])
  @@index([alias])
  @@map("food_aliases")
}

/// One measured nutrient value for one food, from one source release.
///
/// THE MISSING/ZERO RULE: a row exists only when the source actually published
/// a value. "Not measured" is the absence of a row, never a zero. Zero means
/// the source measured it and found none — a different fact, and one that
/// matters when a dietitian is looking at iron content.
///
/// NUMERIC, never float. These are authoritative reference values; a figure
/// that changes when it round-trips through binary floating point is not
/// reference data.
model FoodNutrient {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foodId     String @map("food_id") @db.Uuid
  nutrientId String @map("nutrient_id") @db.Uuid

  /// Which release supplied this figure. Required — a nutrition value with no
  /// traceable origin is exactly what this phase exists to prevent.
  sourceVersionId String @map("source_version_id") @db.Uuid

  /// Stored exactly as published, unrounded. Display rounding is a UI concern.
  value Decimal      @db.Decimal(14, 6)
  /// Denormalised from the nutrient so a value keeps the unit it was validated
  /// against, even if the dictionary entry is later corrected. A mismatch
  /// between the two is a data-quality signal, not something to silently fix.
  unit  NutrientUnit

  /// What the value is per — 100 g for IFCT and USDA. Without this a figure is
  /// meaningless, and assuming 100 g for a source that publishes per-serving
  /// would corrupt every calculation built on it later.
  basisQuantity Decimal @default(100) @map("basis_quantity") @db.Decimal(12, 4)
  basisUnitCode String  @default("g") @map("basis_unit_code") @db.VarChar(20)

  /// The publisher's own nutrient identifier, kept verbatim for traceability.
  sourceNutrientCode String? @map("source_nutrient_code") @db.VarChar(80)
  /// Analytical detail from the source: method, sample count, whether the
  /// figure was imputed. Preserved rather than discarded.
  metadata           Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  food          Food                   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient      Nutrient               @relation(fields: [nutrientId], references: [id], onDelete: Restrict)
  sourceVersion NutritionSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)

  /// One value per nutrient per food per release — which is what makes an
  /// import idempotent, and what lets IFCT 2017 and a later revision coexist
  /// on the same food without either overwriting the other.
  @@unique([foodId, nutrientId, sourceVersionId])
  @@index([foodId])
  @@index([nutrientId])
  @@index([sourceVersionId])
  @@map("food_nutrients")
}

/// An external dataset record, and what it maps to.
///
/// The staging boundary between "what the file said" and "what Vyom believes".
/// Every row read from a dataset lands here with its original identifier and
/// name, whether or not it could be tied to a canonical food.
///
/// This is what makes matching auditable rather than magical. Nothing here is
/// AI: mapping is deterministic on the publisher's identifier, and anything
/// ambiguous is parked at REVIEW_REQUIRED for a human.
model SourceFood {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceVersionId String @map("source_version_id") @db.Uuid

  /// The publisher's identifier within that release, verbatim.
  externalId       String  @map("external_id") @db.VarChar(80)
  externalName     String  @map("external_name") @db.VarChar(300)
  /// The publisher's own category wording, before it was mapped onto
  /// FoodCategory. Kept so a mis-mapping can be found and re-run.
  externalCategory String? @map("external_category") @db.VarChar(200)

  /// Null until mapped. A row with no canonical food is not a failure — it is
  /// an honest record of something the importer would not guess at.
  foodId String? @map("food_id") @db.Uuid

  mappingStatus SourceFoodMappingStatus @default(UNMAPPED) @map("mapping_status")
  /// 0–1, how certain the deterministic match was. Recorded for review
  /// ordering; nothing acts on it automatically.
  confidence    Decimal?                @db.Decimal(4, 3)
  notes         String?                 @db.Text

  /// The original row, as parsed. The audit trail of record: whatever a later
  /// normalisation gets wrong can be recovered from here without the file.
  rawPayload Json? @map("raw_payload") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceVersion NutritionSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  food          Food?                  @relation(fields: [foodId], references: [id], onDelete: SetNull)

  /// Duplicate detection: source + version + external id. Re-reading the same
  /// file updates these rows rather than duplicating them.
  @@unique([sourceVersionId, externalId])
  @@index([mappingStatus])
  @@index([foodId])
  @@map("source_foods")
}

/// A unit of measure — grams, millilitres, katori, piece.
///
/// The model only. Phase 8A establishes the vocabulary and the shape of a
/// conversion; the conversion *engine* belongs to the calculation phase, where
/// it can be built against reference portion sizes rather than guessed.
model Unit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stable identifier, e.g. "g", "ml", "katori".
  code     String       @unique @db.VarChar(20)
  name     String       @db.VarChar(80)
  category UnitCategory

  /// The base unit of its category — grams for WEIGHT, millilitres for VOLUME.
  /// Exactly one per category; enforced by a partial unique index.
  isCanonical Boolean @default(false) @map("is_canonical")

  /// True for units whose gram equivalent depends on the food. A katori of dal
  /// and a katori of rice do not weigh the same, so these can never have a
  /// single global conversion.
  requiresFoodContext Boolean @default(false) @map("requires_food_context")

  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversionsFrom UnitConversion[] @relation("ConversionFrom")
  conversionsTo   UnitConversion[] @relation("ConversionTo")

  @@index([category, isActive])
  @@map("units")
}

/// How much of one unit another is worth.
///
/// Two kinds of row, distinguished by `foodId`:
///   - global   (foodId null)  1 kg = 1000 g. True everywhere.
///   - specific (foodId set)   1 katori of cooked rice = N g. True only for
///                             that food, and sourced, never invented.
///
/// No food-specific conversion data is seeded. A household measure without a
/// published reference is a guess, and guessing portion weights would put
/// invented numbers underneath every future calculation.
model UnitConversion {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUnitId String @map("from_unit_id") @db.Uuid
  toUnitId   String @map("to_unit_id") @db.Uuid

  /// Null for a universal conversion; set when it holds only for one food.
  foodId String? @map("food_id") @db.Uuid

  /// value_in_to_unit = value_in_from_unit × factor.
  factor Decimal @db.Decimal(16, 8)

  /// Where the factor came from. Free text rather than a source FK because a
  /// household portion may come from a guideline document rather than a
  /// dataset — but it is never blank by accident.
  sourceNote String? @map("source_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fromUnit Unit  @relation("ConversionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit   Unit  @relation("ConversionTo", fields: [toUnitId], references: [id], onDelete: Restrict)
  food     Food? @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId, foodId], map: "unit_conversions_unique")
  @@index([foodId])
  @@map("unit_conversions")
}

/// The manifest of one ingestion run.
///
/// Written before the work starts and updated when it ends, so a crashed import
/// leaves a RUNNING row rather than no evidence at all. This is the
/// reproducibility record: which file, which checksum, how many rows, what
/// failed and why.
///
/// Counts here are always real. Nothing writes an expected or estimated figure.
model DatasetImport {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceVersionId String @map("source_version_id") @db.Uuid

  status DatasetImportStatus @default(RUNNING)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// File name only, never an absolute path — a machine's directory layout is
  /// not something to persist or leak.
  inputFile     String? @map("input_file") @db.VarChar(300)
  /// SHA-256 of the input. Two imports with the same checksum read identical
  /// bytes, which is what makes a run reproducible after the fact.
  inputChecksum String? @map("input_checksum") @db.VarChar(64)

  recordsRead     Int @default(0) @map("records_read")
  recordsImported Int @default(0) @map("records_imported")
  recordsSkipped  Int @default(0) @map("records_skipped")
  recordsFailed   Int @default(0) @map("records_failed")

  /// Structured diagnostics, capped by the importer so one pathological file
  /// cannot write an unbounded row.
  warnings Json? @db.JsonB
  errors   Json? @db.JsonB
  /// Per-run detail: nutrient rows written, values missing, mappings needing
  /// review. The data-quality report reads this.
  metadata Json? @db.JsonB

  /// Set when the run was started with --dry-run. A dry run reports exactly
  /// what a real one would do and writes nothing but this manifest.
  dryRun Boolean @default(false) @map("dry_run")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceVersion NutritionSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)

  @@index([sourceVersionId, startedAt(sort: Desc)])
  @@index([status])
  @@map("dataset_imports")
}
