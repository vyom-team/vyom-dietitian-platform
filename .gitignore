# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values
.env
.env.*
# ...but the documented template must be committed
!.env.example

# local editor settings
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client — generated from schema.prisma by `npm run db:generate`
# (also runs on postinstall, so a fresh clone gets it automatically)
/src/generated/prisma

# Agent skill docs vendored by `prisma init`. Not committed: .agents/skills is
# ~465KB of third-party documentation, and the .claude/.windsurf copies are
# absolute-path symlinks into it that would break on any other machine.
# Recreate locally with `npx prisma init` if you want them.
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# raw nutrition datasets — NEVER committed
#
# These are third-party files (IFCT, INDB, USDA) whose redistribution terms
# have not been reviewed for this project, and they are not ours to publish.
# The IFCT 2017 PDF in particular is ICMR-NIN copyright, All Rights Reserved,
# and carries a technical restriction denying text extraction. Committing it
# would be redistribution.
#
# The importer reads these from here; the web application never does.
# Override the location with NUTRITION_DATA_DIR.
/data/nutrition/raw/
/data/nutrition/processed/

# ...but the provenance record IS committed, so what we hold and under what
# terms is reviewable without the files themselves.
!/data/nutrition/README.md
!/data/nutrition/manifests/
